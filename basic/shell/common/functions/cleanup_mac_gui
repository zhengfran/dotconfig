# Manually close user GUI applications on macOS.
# This file is sourced by both zsh and bash through common/functions; it only
# defines the command and does not run it automatically.

function cleanup_mac_gui() {
    [[ "$(uname -s 2>/dev/null)" == "Darwin" ]] || return 0
    command -v ps >/dev/null 2>&1 || return 0

    local login_user app_processes app_records app_names
    local pid owner command app_path process_name process_name_record
    local candidate_pid seen seen_name count suffix answer
    login_user="$(id -un 2>/dev/null)" || return 0
    app_names=()
    app_records=""

    # A macOS .app process has an executable path containing
    # .app/Contents/MacOS/. This avoids AppleScript/Accessibility permissions
    # and also catches helpers belonging to the same GUI application bundle.
    app_processes="$(ps -axo pid=,user=,command= 2>/dev/null)" || return 0

    while read -r pid owner command; do
        [[ "$pid" =~ ^[0-9]+$ ]] || continue

        # Never affect another logged-in user's GUI processes.
        [[ "$owner" == "$login_user" ]] || continue
        case "$command" in
            *.app/Contents/MacOS/*) ;;
            *) continue ;;
        esac

        # Use the first .app in the path so helpers nested inside an app
        # bundle share the parent app's prompt.
        app_path="${command%%.app/*}.app"

        # Only offer ordinary user-installed applications. This filters out
        # macOS agents in /System and /Library, framework helpers, and support
        # apps such as Karabiner's menu/notification processes.
        case "$app_path" in
            /Applications/*.app|"$HOME"/Applications/*.app) ;;
            *) continue ;;
        esac

        process_name="${app_path##*/}"
        process_name="${process_name%.app}"

        # Keep the desktop and terminal alive; all other discovered app bundles
        # are offered for confirmation below.
        case "$process_name" in
            Dock|Finder|System\ Events|SystemUIServer|ControlCenter|NotificationCenter|WindowServer|loginwindow|UserEventAgent|Terminal|iTerm2|Warp|Alacritty|kitty|WezTerm)
                continue
                ;;
        esac

        app_records+="${pid}"$'\t'"${process_name}"$'\n'
        seen=0
        for seen_name in "${app_names[@]}"; do
            if [[ "$seen_name" == "$process_name" ]]; then
                seen=1
                break
            fi
        done
        if [[ "$seen" -eq 0 ]]; then
            app_names+=("$process_name")
        fi
    done <<< "$app_processes"

    if [[ "${#app_names[@]}" -eq 0 ]]; then
        printf '%s\n' 'No GUI applications found.'
        return 0
    fi

    printf '%s\n' 'GUI applications available to close:'
    for process_name in "${app_names[@]}"; do
        count=0
        while IFS=$'\t' read -r candidate_pid process_name_record; do
            [[ "$process_name_record" == "$process_name" ]] || continue
            count=$((count + 1))
        done <<< "$app_records"
        suffix="processes"
        [[ "$count" -eq 1 ]] && suffix="process"
        printf '  %s (%d %s)\n' "$process_name" "$count" "$suffix"
    done

    for process_name in "${app_names[@]}"; do
        printf 'Close %s? [y/N] ' "$process_name"
        if ! IFS= read -r answer < /dev/tty; then
            printf '\nUnable to read confirmation; skipping %s.\n' "$process_name"
            continue
        fi
        case "$answer" in
            [Yy]|[Yy][Ee][Ss]) ;;
            *)
                printf 'Skipped %s.\n' "$process_name"
                continue
                ;;
        esac

        while IFS=$'\t' read -r candidate_pid process_name_record; do
            [[ "$process_name_record" == "$process_name" ]] || continue
            kill -TERM "$candidate_pid" 2>/dev/null || true
        done <<< "$app_records"
        printf 'Closed %s.\n' "$process_name"
    done
}
