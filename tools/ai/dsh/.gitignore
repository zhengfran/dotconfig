# ~/.dsh/profiles is symlinked here. Track each profile's manifest, lockfile
# and patch layer; ignore installed/generated trees and runtime logs.
# - profiles/node_modules: dsh's shared host-package mirror (rebuilt at boot)
# - profiles/*/node_modules: pnpm install output
# - profiles/*/.dsh-module-fallback: dsh's per-profile bundle links
node_modules/
.dsh-module-fallback/
**/.dsh-market/log.ndjson
**/.dsh-market/*-cache*.json
**/.dsh-market/discovery-*.json
# - cordis.patch.yml: dsh writes runtime UI settings and secrets here
#   (e.g. remote-web-ui tunnelToken), so it stays local per machine
**/cordis.patch.yml
# Multica's bridge is a machine-local build and cannot be shared as a profile.
profiles/multica
