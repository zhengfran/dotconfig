# Copy to ~/.config/mcp/secrets.env (chmod 600). Read only by bin/mcp-run, and
# each server receives only its own variables, so GITHUB_TOKEN here does not
# leak into gh or your shell.

# jira-connector
JIRA_BASE_URL=https://jira.example.com
JIRA_PAT=

# confluence-connector
CONFLUENCE_BASE_URL=https://confluence.example.com
CONFLUENCE_PAT=

# github-connector (GitHub Enterprise API root, e.g. https://ghe.example.com/api/v3)
GITHUB_URL=
GITHUB_TOKEN=
GITHUB_ORG=
